    "帮助_单元格修正_类型3": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "单值：保留当前单元格的显示值，并将其标记为手动修正。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "單值：保留目前儲存格的顯示值，並將其標記為手動修正。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Single: Keep the current cell display value and mark it as a manual correction."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "単値：現在のセルの表示値を保持し、手動修正としてマークします。"
          }
        }
      }
    },
    "帮助_修正规则": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "修正规则"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "修正規則"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Correction Rules"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "修正ルール"
          }
        }
      }
    },
    "帮助_修正规则_介绍": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "修正规则（Schema）是一组可复用的单元格修正规则。特别适用于周期性重复汇总的场景（如月度/季度财务报表合并）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "修正規則（Schema）是一組可複用的儲存格修正規則。特別適用於週期性重複匯總的場景（如月度/季度財務報表合併）。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Correction rules (Schema) are reusable cell correction rules. They are especially useful for recurring merge tasks such as monthly/quarterly financial reports."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "修正ルール（Schema）は再利用可能なセル修正ルールです。月次/四半期財務レポートなど、繰り返し行われるマージ作業に特に便利です。"
          }
        }
      }
    },
    "帮助_修正规则_核心功能标题": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "核心功能"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "核心功能"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Core Features"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "核心機能"
          }
        }
      }
    },
    "帮助_修正规则_自动匹配": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动匹配：导入文件时，程序自动检测是否存在匹配的修正规则。若文件结构与已保存的规则高度吻合，自动应用已有修正规则。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自動匹配：匯入檔案時，程式自動檢測是否存在匹配的修正規則。若檔案結構與已儲存的規則高度吻合，自動套用已有修正規則。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto-match: When importing files, the app automatically detects matching correction rules and applies them when the file structure closely matches."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動一致：ファイルをインポートするとき、アプリは一致する修正ルールを自動検出し、ファイル構造が密接に一致する場合に適用します。"
          }
        }
      }
    },
    "帮助_修正规则_保存规则": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存规则：通过「修正规则 → 保存当前修正规则」（⌘S）将当前工作区的所有修正规则持久化保存。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "儲存規則：透過「修正規則 → 儲存目前修正規則」（⌘S）將目前工作區的所有修正規則持久化儲存。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save Rules: Use Correction Rules → Save Current Correction Rules (⌘S) to persist all current correction rules."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ルールの保存：「修正ルール → 現在の修正ルールを保存」（⌘S）を使用して、現在のすべての修正ルールを永続化します。"
          }
        }
      }
    },
    "帮助_修正规则_管理规则": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "管理规则：通过「修正规则 → 查看当前修正规则」管理已保存的规则：查看修正明细、导入/导出 JSON 文件、清除过时规则。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "管理規則：透過「修正規則 → 查看目前修正規則」管理已儲存的規則：查看修正明細、匯入/匯出 JSON 檔案、清除過時規則。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Manage Rules: Use Correction Rules → View Current Correction Rules to inspect details, import/export JSON files, and remove outdated rules."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ルールの管理：「修正ルール → 現在の修正ルールを表示」を使用して、詳細の確認、JSON ファイルのインポート/エクスポート、古いルールの削除を行います。"
          }
        }
      }
    },
    "帮助_修正规则_最佳实践标题": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最佳实践"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "最佳實踐"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Best Practices"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ベストプラクティス"
          }
        }
      }
    },
    "帮助_修正规则_最佳实践1": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为每个报表模板创建独立的修正规则，命名规则如「华东区月度销售报表」。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為每個報表範本建立獨立的修正規則，命名規則如「華東區月度銷售報表」。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create independent correction rules for each report template, e.g., \"East China Monthly Sales Report\"."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各レポートテンプレートに対して独立した修正ルールを作成します。例：「東中国地域月次売上レポート」。"
          }
        }
      }
    },
    "帮助_修正规则_最佳实践2": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 .json 格式导出/导入修正规则，便于团队共享和版本管理。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 .json 格式匯出/匯入修正規則，便於團隊共享和版本管理。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Export/import correction rules in .json format for easy team sharing and version control."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チームでの共有とバージョン管理のために、修正ルールを .json 形式でエクスポート/インポートします。"
          }
        }
      }
    },
    "帮助_修正规则_最佳实践3": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "结构发生变化时，及时更新修正规则以避免旧规则错误应用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "結構發生變化時，及時更新修正規則以避免舊規則錯誤套用。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Update correction rules promptly when the structure changes to avoid incorrect application of old rules."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "構造が変更された場合は、古いルールが誤って適用されるのを防ぐために、修正ルールを適切に更新してください。"
          }
        }
      }
    },
    "帮助_修正规则_技术说明": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "技术说明：修正规则基于「结构指纹」（列名 + 行位置 + 数据类型）进行匹配，而非文件名。因此即使文件来源不同，只要结构一致即可复用规则。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "技術說明：修正規則基於「結構指紋」（列名 + 行位置 + 資料類型）進行匹配，而非檔案名。因此即使檔案來源不同，只要結構一致即可複用規則。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Technical Note: Correction rules are matched based on a structural fingerprint (column names + row positions + data types), not file names. Therefore, rules can be reused across different files as long as the structure matches."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "技術的な注意：修正ルールは、ファイル名ではなく構造フィンガープリント（列名 + 行位置 + データ型）に基づいて一致します。そのため、構造が一致していれば、異なるファイル間でルールを再利用できます。"
          }
        }
      }
    },
