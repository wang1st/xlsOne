    "帮助_调整记忆_管理说明": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过菜单“修正规则”→“查看当前修正规则”可以打开管理面板。您可以为当前批次保存一份规则文件，也可以从之前保存的规则文件导入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "透過選單「修正規則」→「檢視目前修正規則」可以開啟管理面板。您可以為目前批次儲存一份規則檔案，也可以從之前儲存的規則檔案匯入。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the management panel via Correction Rules → View Current Correction Rules. You can save a rules file for the current batch or import a previously saved one."
          }
        }
      }
    },
    "帮助_调整记忆_注意": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "注意：修正规则基于工作表表头结构匹配。如果表头发生较大变化，规则可能不会自动生效。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "注意：修正規則基於工作表表頭結構匹配。如果表頭發生較大變化，規則可能不會自動生效。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Note: Correction rules are matched by worksheet header structure. If headers change significantly, the rules may not apply automatically."
          }
        }
      }
    },
