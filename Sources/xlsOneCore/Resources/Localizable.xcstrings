        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mark selected cells as Single"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択セルを単値としてマーク"
          }
        }
      }
    },
    "帮助_快捷键_帮助": {
