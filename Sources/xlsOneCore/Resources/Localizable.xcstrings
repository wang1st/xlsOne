    "帮助_常见问题": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "常见问题"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "常見問題"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "FAQ"
          }
        }
      }
    },
    "帮助_常见问题_问题1": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为什么有些 Sheet 会被跳过？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為什麼有些 Sheet 會被跳過？"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Why are some sheets skipped?"
          }
        }
      }
    },
    "帮助_常见问题_答案1": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当同一个 Sheet 在不同文件中的有效数据区域、行数、列数或表头不一致时，程序无法按位置对齐，就会跳过该 Sheet。您可以根据“已跳过”页面给出的结构分组提示，统一各文件后再重新导入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當同一個 Sheet 在不同檔案中的有效資料區域、行數、列數或表頭不一致時，程式無法按位置對齊，就會跳過該 Sheet。您可以根據「已跳過」頁面給出的結構分組提示，統一各檔案後再重新匯入。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A sheet is skipped when its used range, row/column count, or headers differ across files, preventing positional alignment. Follow the structural grouping hints on the Skipped page, unify the files, and import again."
          }
        }
      }
    },
    "帮助_常见问题_问题2": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "汇总结果会修改原始文件吗？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "匯總結果會修改原始檔案嗎？"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Will merging modify my original files?"
          }
        }
      }
    },
    "帮助_常见问题_答案2": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不会。所有读取、汇总和修正操作均在内存中完成，只有点击“导出 XLSX”后才会生成新的 Excel 文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不會。所有讀取、匯總和修正操作均在記憶體中完成，只有點擊「匯出 XLSX」後才會產生新的 Excel 檔案。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No. All reading, merging, and correction operations happen in memory. A new Excel file is created only when you click Export XLSX."
          }
        }
      }
    },
    "帮助_常见问题_问题3": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "支持哪些 Excel 格式？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "支援哪些 Excel 格式？"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Which Excel formats are supported?"
          }
        }
      }
    },
    "帮助_常见问题_答案3": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目前支持 .xlsx 和 .xls 格式。建议导入前确保文件未被密码保护，且各文件表头一致。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前支援 .xlsx 和 .xls 格式。建議匯入前確保檔案未被密碼保護，且各檔案表頭一致。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app currently supports .xlsx and .xls files. Make sure files are not password-protected and share consistent headers before importing."
          }
        }
      }
    },
    "帮助_常见问题_问题4": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如何撤销误操作？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如何撤銷誤操作？"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How do I undo a mistake?"
          }
        }
      }
    },
    "帮助_常见问题_答案4": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对于单元格修正，可以点击工具栏“撤销上一步”按钮，或按 Command+Z。如果要清除当前批次的所有修正，可以点击“清除本批次调整”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對於儲存格修正，可以點擊工具列「撤銷上一步」按鈕，或按 Command+Z。如果要清除目前批次的所有修正，可以點擊「清除本批次調整」。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For cell corrections, click Undo in the toolbar or press Command+Z. To clear all corrections for the current batch, click Clear Batch Corrections."
          }
        }
      }
    },
