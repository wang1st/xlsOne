    "帮助_穿透查阅_介绍": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "汇总表的每个单元格都支持穿透查阅，帮助追溯数据来源。"
          }
