    "帮助_调整记忆": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "调整记忆"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "調整記憶"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adjustment Memory"
          }
        }
      }
    },
    "帮助_调整记忆_介绍": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "调整记忆会记住您对单元格类型的修正，以便在下次处理相似结构的工作簿时自动应用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "調整記憶會記住您對儲存格類型的修正，以便在下次處理相似結構的工作簿時自動套用。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adjustment Memory remembers your cell-type corrections so they can be applied automatically the next time you process workbooks with a similar structure."
          }
        }
      }
    },
    "帮助_调整记忆_作用标题": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主要作用"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "主要作用"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What It Does"
          }
        }
      }
    },
    "帮助_调整记忆_作用1": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "减少重复修正：相同的表头结构再次导入时，会自动应用您之前的修正。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "減少重複修正：相同的表頭結構再次匯入時，會自動套用您之前的修正。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fewer repeated corrections: Previous corrections are applied automatically when the same header structure is imported again."
          }
        }
      }
    },
    "帮助_调整记忆_作用2": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提高工作效率：尤其适合需要定期汇总固定格式报表的场景。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "提高工作效率：尤其適合需要定期匯總固定格式報表的場景。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Improved efficiency: Especially useful when you regularly merge reports with a fixed format."
          }
        }
      }
    },
    "帮助_调整记忆_作用3": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可随时查看、保存或清除已记住的调整。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可隨時查看、儲存或清除已記住的調整。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can view, save, or clear remembered adjustments at any time."
          }
        }
      }
    },
