    "帮助_调整记忆_管理说明": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过菜单“调整记忆”→“查看当前调整记忆”可以打开管理面板。您可以为当前批次保存一份记忆文件，也可以从之前保存的记忆文件导入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "透過選單「調整記憶」→「查看目前調整記憶」可以開啟管理面板。您可以為目前批次儲存一份記憶檔案，也可以從之前儲存的記憶檔案匯入。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the management panel via Adjustment Memory → View Current Adjustment Memory. You can save a memory file for the current batch or import a previously saved one."
          }
        }
      }
    },
    "帮助_调整记忆_注意": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "注意：调整记忆基于工作表表头结构匹配。如果表头发生较大变化，记忆可能不会自动生效。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "注意：調整記憶基於工作表表頭結構匹配。如果表頭發生較大變化，記憶可能不會自動生效。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Note: Adjustment memory is matched by worksheet header structure. If headers change significantly, the memory may not apply automatically."
          }
        }
      }
    },
