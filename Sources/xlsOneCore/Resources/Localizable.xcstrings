    "帮助_穿透查阅_步骤1": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在汇总表格中单击任意单元格。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在汇总表格中单击任意单元格。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click any cell in the merged table."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マージされた表の任意のセルをクリックします。"
          }
        }
      }
    },
    "帮助_穿透查阅_步骤2": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "右侧面板列出该单元格在各源文件中的原始值，标注文件名和具体数值。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "右侧面板列出该单元格在各源文件中的原始值，标注文件名和具体数值。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The right panel lists the original values of that cell across source files."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "右側のパネルに、ソースファイルごとのセルの元の値が表示されます。"
          }
        }
      }
    },
    "帮助_穿透查阅_步骤3": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "若某个文件的值与其他文件差异较大，可快速定位该文件进行核实。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
