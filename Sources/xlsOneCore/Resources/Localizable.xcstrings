      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "追加文件"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "追加檔案"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adding More Files"
          }
        }
      }
    },
    "帮助_导入文件_追加说明": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果已经导入了一批文件，想要继续加入更多报表，可以点击工具栏“追加”按钮，或按 Command+Shift+O。追加的文件会与当前批次一起重新汇总。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如果已經匯入了一批檔案，想要繼續加入更多報表，可以點擊工具列「追加」按鈕，或按 Command+Shift+O。追加的檔案會與目前批次一起重新匯總。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you have already imported a batch and want to add more reports, click the Append button in the toolbar or press Command+Shift+O. The newly added files are merged together with the current batch."
          }
        }
      }
    },
    "帮助_导入文件_注意": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "注意：程序不会修改原始 Excel 文件，所有汇总操作均在内存中进行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "注意：程式不會修改原始 Excel 檔案，所有匯總操作均在記憶體中進行。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Note: The app never modifies your original Excel files; all merging happens in memory."
          }
        }
      }
    },
    "帮助_查看汇总结果": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看汇总结果"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "查看匯總結果"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Viewing Merge Results"
          }
        }
      }
    },
    "帮助_查看汇总结果_介绍": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导入成功后，主界面会显示汇总后的工作表。可合并的工作表会自动合并为一个结果表，您可以通过顶部标签切换查看。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "匯入成功後，主介面會顯示匯總後的工作表。可合併的工作表會自動合併為一個結果表，您可以透過頂部標籤切換查看。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After a successful import, the main window shows the merged worksheet. Mergeable sheets are combined into a single result table, which you can switch between using the top tabs."
          }
        }
      }
    },
    "帮助_查看汇总结果_合并逻辑标题": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "合并规则"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "合併規則"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Merge Rules"
          }
        }
      }
    },
    "帮助_查看汇总结果_合并逻辑1": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可相加的数值（金额、数量等）会自动求和。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可相加的數值（金額、數量等）會自動求和。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Summable numbers such as amounts and quantities are automatically totaled."
          }
        }
      }
    },
    "帮助_查看汇总结果_合并逻辑2": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文本、编号、名称等不可相加的内容会保留出现次数最多的共同值。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "文字、編號、名稱等不可相加的內容會保留出現次數最多的共同值。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Text, codes, names, and other non-summable fields keep the most common shared value."
          }
        }
      }
    },
    "帮助_查看汇总结果_合并逻辑3": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果某个单元格在不同文件中数值差异较大，会被标记为异常，方便您重点检查。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如果某個儲存格在不同檔案中數值差異較大，會被標記為異常，方便您重點檢查。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cells whose values vary significantly across files are flagged as anomalies for your review."
          }
        }
      }
    },
    "帮助_查看汇总结果_穿透查阅标题": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "穿透查阅"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "穿透查閱"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Source Drilldown"
          }
        }
      }
    },
    "帮助_查看汇总结果_穿透查阅说明": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击汇总表中的任意单元格，右侧面板会列出该单元格在所有来源文件中的原始值、文件名以及所在位置。这让您可以快速核对数据来源。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點擊匯總表中的任意儲存格，右側面板會列出該儲存格在所有來源檔案中的原始值、檔案名以及所在位置。這讓您可以快速核對資料來源。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click any cell in the merged table; the right panel lists its original value in every source file, along with the filename and location, so you can quickly verify the data."
          }
        }
      }
    },
    "帮助_查看汇总结果_提示": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提示：使用键盘 J / K 可以快速跳转到下一个或上一个异常单元格。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "提示：使用鍵盤 J / K 可以快速跳轉到下一個或上一個異常儲存格。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tip: Press J / K to jump to the next or previous anomaly cell."
          }
        }
      }
    },
    "帮助_工作表状态": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "工作表状态"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "工作表狀態"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sheet Status"
          }
        }
      }
    },
    "帮助_工作表状态_介绍": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导入多个文件后，每个 Sheet 标签会显示该工作表的汇总状态。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "匯入多個檔案後，每個 Sheet 標籤會顯示該工作表的匯總狀態。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After importing multiple files, each sheet tab shows the merge status of that worksheet."
          }
        }
      }
    },
    "帮助_工作表状态_可合并标题": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可合并"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可合併"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mergeable"
          }
        }
      }
    },
    "帮助_工作表状态_可合并说明": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "表示该 Sheet 在所有文件中的结构一致，已成功参与汇总。点击标签即可查看合并后的结果。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "表示該 Sheet 在所有檔案中的結構一致，已成功參與匯總。點擊標籤即可查看合併後的結果。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sheet has a consistent structure across all files and has been included in the merge. Click the tab to view the merged result."
          }
        }
      }
    },
    "帮助_工作表状态_已跳过标题": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已跳过"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已跳過"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Skipped"
          }
        }
      }
    },
    "帮助_工作表状态_已跳过说明": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "表示该 Sheet 在不同文件中的结构不一致，暂时无法自动合并。常见原因包括："
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "表示該 Sheet 在不同檔案中的結構不一致，暫時無法自動合併。常見原因包括："
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sheet could not be merged automatically because its structure differs across files. Common reasons include:"
          }
        }
      }
    },
    "帮助_工作表状态_跳过原因1": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有效数据区域（起始行/列）不同。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有效資料區域（起始行/列）不同。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The used data range (starting row/column) differs."
          }
        }
      }
    },
    "帮助_工作表状态_跳过原因2": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "行数或列数不一致，导致无法按位置对齐。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "行數或列數不一致，導致無法按位置對齊。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Row or column counts differ, preventing positional alignment."
          }
        }
      }
    },
    "帮助_工作表状态_跳过原因3": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "表头内容存在明显差异。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "表頭內容存在明顯差異。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Header content differs significantly."
          }
        }
      }
    },
    "帮助_工作表状态_注意": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "注意：对于已跳过的 Sheet，程序会展示结构分组分析。您可以根据提示统一各文件的行列范围后重新导入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "注意：對於已跳過的 Sheet，程式會展示結構分組分析。您可以根據提示統一各檔案的行列範圍後重新匯入。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Note: For skipped sheets, the app shows a structural grouping analysis. You can adjust the files to use the same row/column ranges and import again."
          }
        }
      }
    },
    "帮助_单元格修正": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "单元格修正"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "儲存格修正"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cell Correction"
          }
        }
      }
    },
    "帮助_单元格修正_介绍": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当程序对某个单元格的合并类型判断不准确时，您可以手动指定其类型。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當程式對某個儲存格的合併類型判斷不準確時，您可以手動指定其類型。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If the app misclassifies a cell’s merge behavior, you can manually override its type."
          }
        }
      }
    },
    "帮助_单元格修正_类型标题": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "修正类型"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "修正類型"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Correction Types"
          }
        }
      }
    },
    "帮助_单元格修正_类型1": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标签：将该单元格视为文本，汇总时保留最频繁出现的值，不参与求和。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "標籤：將該儲存格視為文字，匯總時保留最頻繁出現的值，不參與求和。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Label: Treat the cell as text; the merged result keeps the most frequent value and it is not summed."
          }
        }
      }
    },
    "帮助_单元格修正_类型2": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "求和：将该单元格视为数值，汇总时对所有来源文件的对应单元格求和。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "求和：將該儲存格視為數值，匯總時對所有來源檔案的對應儲存格求和。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sum: Treat the cell as numeric; the merged result sums the corresponding cells from all source files."
          }
        }
      }
    },
    "帮助_单元格修正_操作标题": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如何修正"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如何修正"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How to Correct"
          }
        }
      }
    },
    "帮助_单元格修正_操作1": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在汇总表中点击需要修正的单元格。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在匯總表中點擊需要修正的儲存格。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click the cell you want to correct in the merged table."
          }
        }
      }
    },
    "帮助_单元格修正_操作2": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在右侧面板选择“修正为标签”或“修正为求和”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在右側面板選擇「修正為標籤」或「修正為求和」。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose Correct to Label or Correct to Sum in the right panel."
          }
        }
      }
    },
    "帮助_单元格修正_操作3": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "也可以右键点击单元格，在上下文菜单中选择修正类型。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "也可以右鍵點擊儲存格，在上下文選單中選擇修正類型。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can also right-click the cell and choose a correction type from the context menu."
          }
        }
      }
    },
    "帮助_单元格修正_操作4": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选中多个单元格后，可一次性批量应用相同的修正。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選取多個儲存格後，可一次性批量套用相同的修正。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select multiple cells to apply the same correction to all of them at once."
          }
        }
      }
    },
    "帮助_单元格修正_提示": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提示：选中的单元格会高亮显示，Command+Z 可撤销最近一次的修正操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "提示：選取的儲存格會高亮顯示，Command+Z 可撤銷最近一次的修正操作。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tip: Selected cells are highlighted, and Command+Z undoes the most recent correction."
          }
        }
      }
    },
    "帮助_调整记忆": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "修正规则"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
