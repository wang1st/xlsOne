    },
    "帮助_快速开始_介绍": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "表表归一可以将多张格式相同的 Excel 报表快速汇总成一张工作表。只需导入文件，程序会自动识别可合并的工作表并完成汇总。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "表表歸一可以將多張格式相同的 Excel 報表快速匯總成一張工作表。只需匯入檔案，程式會自動識別可合併的工作表並完成匯總。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "xlsOne quickly merges multiple identically-formatted Excel reports into a single sheet. Just import your files, and the app automatically detects mergeable sheets and produces the summary."
          }
        }
      }
    },
    "帮助_快速开始_步骤标题": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "五步完成汇总"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "五步完成匯總"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Five Steps to Merge"
          }
        }
      }
    },
    "帮助_快速开始_步骤1": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击工具栏“导入文件”或直接将 .xlsx / .xls 文件拖入窗口。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點擊工具列「匯入檔案」或直接將 .xlsx / .xls 檔案拖入視窗。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click Import Files in the toolbar, or drag .xlsx / .xls files into the window."
          }
        }
      }
    },
    "帮助_快速开始_步骤2": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "程序会自动校验所有工作簿结构，识别出可合并与已跳过的 Sheet。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "程式會自動校驗所有工作簿結構，識別出可合併與已跳過的 Sheet。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app validates every workbook and identifies mergeable vs. skipped sheets."
          }
        }
      }
    },
    "帮助_快速开始_步骤3": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击顶部 Sheet 标签切换不同报表页，查看汇总结果。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點擊頂部 Sheet 標籤切換不同報表頁，查看匯總結果。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click the sheet tabs at the top to switch report pages and view merged results."
          }
        }
      }
    },
    "帮助_快速开始_步骤4": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选中单元格可在右侧面板查看各来源文件的原始值。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選取儲存格可在右側面板查看各來源檔案的原始值。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select any cell to inspect the original values from each source file in the right panel."
          }
        }
      }
    },
    "帮助_快速开始_步骤5": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认无误后点击“导出 XLSX”保存汇总结果。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "確認無誤後點擊「匯出 XLSX」儲存匯總結果。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When satisfied, click Export XLSX to save the merged workbook."
          }
        }
      }
    },
    "帮助_快速开始_提示": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提示：导入前请确保所有待汇总文件使用相同的表头和行列结构，这样可获得最佳汇总效果。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "提示：匯入前請確保所有待匯總檔案使用相同的表頭和行列結構，這樣可獲得最佳匯總效果。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tip: For best results, make sure all files share the same headers and row/column layout before importing."
          }
        }
      }
    },
