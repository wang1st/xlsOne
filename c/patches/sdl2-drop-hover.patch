-                return 0;
-            }
-            if (window) {
-                window->is_dropping = SDL_TRUE;
-            } else {
-                app_is_dropping = SDL_TRUE;
-            }
+        if (evtype != SDL_DROPCOMPLETE
+            && !*is_dropping
+            && !SDL_SendDropBegin(window)) {
+            return 0;
@@ -66,6 +80,2 @@ static int SDL_SendDrop(SDL_Window *window, const SDL_EventType evtype, const ch
-        if (posted && (evtype == SDL_DROPCOMPLETE)) {
-            if (window) {
