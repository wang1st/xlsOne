diff --git a/src/events/SDL_dropevents.c b/src/events/SDL_dropevents.c
index a7a9a981f..d75642909 100644
--- a/src/events/SDL_dropevents.c
+++ b/src/events/SDL_dropevents.c
@@ -30,0 +31,24 @@
+static SDL_bool app_is_dropping = SDL_FALSE;
+
+int SDL_SendDropBegin(SDL_Window *window)
+{
+    SDL_bool *is_dropping = window ? &window->is_dropping : &app_is_dropping;
+    int posted = 1;
+
+    if (*is_dropping) {
+        return 1;
+    }
+
+    if (SDL_GetEventState(SDL_DROPBEGIN) == SDL_ENABLE) {
+        SDL_Event event;
+        SDL_zero(event);
+        event.type = SDL_DROPBEGIN;
+        event.drop.windowID = window ? window->id : 0;
+        posted = (SDL_PushEvent(&event) > 0);
+    }
+    if (posted) {
+        *is_dropping = SDL_TRUE;
+    }
+    return posted;
+}
+
