<CPackWiXPatch>
    <CPackWiXFragment Id="#PRODUCTFEATURE">
        <ComponentRef Id="XlsOneDesktopShortcut"/>
    </CPackWiXFragment>

    <CPackWiXFragment Id="#PRODUCT">
        <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT"
                  Value="@XLSONE_WIX_LAUNCH_CHECKBOX_TEXT@"/>
        <CustomAction Id="LaunchXlsOne"
                      Directory="INSTALL_ROOT"
                      ExeCommand="[SystemFolder]cmd.exe /c start &quot;&quot; &quot;[INSTALL_ROOT]xlsOne.exe&quot;"
                      Return="asyncNoWait"
                      Impersonate="yes"/>
        <UI>
            <Publish Dialog="ExitDialog"
                     Control="Finish"
                     Event="DoAction"
                     Value="LaunchXlsOne"
                     Order="1">WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed</Publish>
        </UI>
    </CPackWiXFragment>
</CPackWiXPatch>
