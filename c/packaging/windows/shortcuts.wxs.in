<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
    <Fragment>
        <DirectoryRef Id="TARGETDIR">
            <Directory Id="CommonDesktopFolder" Name="Desktop">
                <Component Id="XlsOneDesktopShortcut"
                           Guid="{F89F8EC6-351C-4F2E-B85F-4E4D87ECA8D6}">
                    <Shortcut Id="XlsOneDesktopShortcutLink"
                              Name="xlsOne"
                              Description="表表归一"
                              Target="[INSTALL_ROOT]xlsOne.exe"
                              WorkingDirectory="INSTALL_ROOT"
                              Icon="ProductIcon.ico"
                              Advertise="no"/>
                    <RegistryValue Root="HKLM"
                                   Key="Software\Z-Pulse\xlsOne"
                                   Name="desktop"
                                   Type="integer"
                                   Value="1"
                                   KeyPath="yes"/>
                </Component>
            </Directory>
        </DirectoryRef>
    </Fragment>
</Wix>
