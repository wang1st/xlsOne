# xlsOne 国内激活 API 环境变量（复制为 /opt/xlsone-activation/.env，权限 600）
# 本文件仅为模板：所有密钥均为占位符，切勿填入真实值、切勿提交到 git。
# 真实密钥经安全通道（密钥管理 / 运维私信）注入服务器 .env，不在仓库中留存。

# Ed25519 私钥种子（64 位 hex），必须与客户端 license_manager.cpp 中固化的公钥配对。
# 与 Cloudflare Worker 的 ED25519_PRIVATE_KEY 保持一致。
ED25519_PRIVATE_KEY=<替换为生产私钥种子：64位hex，须与 license_manager.cpp 中固化公钥配对；经安全通道注入，勿提交>

# macOS 旧版 HMAC/JWT 激活密钥
ACTIVATION_SECRET=<替换为生产 HMAC/JWT 密钥；经安全通道注入，勿提交>

# 管理后台 Bearer Token（默认等于 ACTIVATION_SECRET）
ADMIN_API_KEY=<默认为 ACTIVATION_SECRET；如需独立则替换为专用 Bearer Token，勿提交>

# 爱发电（可选，不填则 webhook 返回 401）
AFDIAN_USER_ID=
AFDIAN_TOKEN=
AFDIAN_WEBHOOK_TOKEN=

# 授权码管理页面路径（可选，默认为 /xlsone/license-console）
# 建议改成自己才知道的随机路径，不要保留 /admin 字样
ADMIN_PATH=/xlsone/license-console

# 服务端口（nginx 反代到 127.0.0.1:8787）
PORT=8787

# 数据存储目录（JSON 文件）
DATA_DIR=/opt/xlsone-activation/data

# 安装包下载目录（/downloads 与 /downloads/<file> 从此读取）
DOWNLOADS_DIR=/opt/xlsone-activation/data/downloads
