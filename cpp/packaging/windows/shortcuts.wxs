<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
    <Fragment>
        <DirectoryRef Id="TARGETDIR">
            <Directory Id="ProgramMenuFolder">
                <Directory Id="ApplicationProgramsFolder" Name="xlsOne">
                    <Component Id="ApplicationShortcut" Guid="{7C2EF978-385C-496D-AC4C-CC807A7EC1FD}">
                        <Shortcut Id="ApplicationStartMenuShortcut"
                                  Name="xlsOne"
                                  Description="Merge identically structured Excel workbooks with one click"
                                  Target="[INSTALL_ROOT]bin\xlsOneQt.exe"
                                  WorkingDirectory="INSTALL_ROOT"
                                  Icon="ProductIcon.ico"
                                  Advertise="no"/>
                        <RemoveFolder Id="ApplicationProgramsFolder" On="uninstall"/>
                        <RegistryValue Root="HKCU" Key="Software\xlsOne" Name="startmenu" Type="integer" Value="1" KeyPath="yes"/>
                    </Component>
                </Directory>
            </Directory>
            <Directory Id="DesktopFolder" Name="Desktop">
                <Component Id="DesktopShortcut" Guid="{C4A888CB-BD98-432E-92D9-3BD23FC0EF6B}">
                    <Shortcut Id="DesktopShortcut"
                              Name="xlsOne"
                              Description="Merge identically structured Excel workbooks with one click"
                              Target="[INSTALL_ROOT]bin\xlsOneQt.exe"
                              WorkingDirectory="INSTALL_ROOT"
                              Icon="ProductIcon.ico"
                              Advertise="no"/>
                    <RegistryValue Root="HKCU" Key="Software\xlsOne" Name="desktop" Type="integer" Value="1" KeyPath="yes"/>
                </Component>
            </Directory>
        </DirectoryRef>
    </Fragment>
</Wix>
