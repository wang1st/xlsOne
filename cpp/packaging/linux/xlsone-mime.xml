<?xml version="1.0" encoding="UTF-8"?>
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet">
    <comment>Excel workbook</comment>
    <glob pattern="*.xlsx"/>
  </mime-type>
  <mime-type type="application/vnd.ms-excel">
    <comment>Excel workbook</comment>
    <glob pattern="*.xls"/>
  </mime-type>
  <mime-type type="text/csv">
    <comment>CSV spreadsheet</comment>
    <glob pattern="*.csv"/>
  </mime-type>
  <mime-type type="text/tab-separated-values">
    <comment>TSV spreadsheet</comment>
    <glob pattern="*.tsv"/>
  </mime-type>
</mime-info>
