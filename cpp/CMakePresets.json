{
  "version": 3,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "dev",
      "inherits": "base",
      "displayName": "Developer Debug",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "XLSONE_UPDATE_BASE_URL": "http://z-pulse.cn"
      }
    },
    {
      "name": "release",
      "inherits": "base",
      "displayName": "Native Release",
      "binaryDir": "${sourceDir}/build-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "windows-release",
      "inherits": "base",
      "displayName": "Windows x86_64 Release",
      "binaryDir": "${sourceDir}/build-windows-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "linux-release",
      "inherits": "base",
      "displayName": "Linux x86_64 Release",
      "binaryDir": "${sourceDir}/build-linux-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "uos-x86_64-release",
      "inherits": "base",
      "displayName": "UOS x86_64 Release",
      "binaryDir": "${sourceDir}/build-uos-x86_64-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "uos-arm64-release",
      "inherits": "base",
      "displayName": "UOS ARM64 Release",
      "binaryDir": "${sourceDir}/build-uos-arm64-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_TOOLCHAIN_FILE": "$env{UOS_ARM64_TOOLCHAIN_FILE}"
      }
    },
    {
      "name": "uos-loongarch64-release",
      "inherits": "base",
      "displayName": "UOS LoongArch64 Release",
      "binaryDir": "${sourceDir}/build-uos-loongarch64-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_TOOLCHAIN_FILE": "$env{UOS_LOONGARCH64_TOOLCHAIN_FILE}"
      }
    }
  ],
  "buildPresets": [
    {"name": "dev", "configurePreset": "dev"},
    {"name": "release", "configurePreset": "release"},
    {"name": "windows-release", "configurePreset": "windows-release"},
    {"name": "linux-release", "configurePreset": "linux-release"},
    {"name": "uos-x86_64-release", "configurePreset": "uos-x86_64-release"},
    {"name": "uos-arm64-release", "configurePreset": "uos-arm64-release"},
    {"name": "uos-loongarch64-release", "configurePreset": "uos-loongarch64-release"}
  ],
  "testPresets": [
    {"name": "dev", "configurePreset": "dev", "output": {"outputOnFailure": true}},
    {"name": "release", "configurePreset": "release", "output": {"outputOnFailure": true}},
    {"name": "linux-release", "configurePreset": "linux-release", "output": {"outputOnFailure": true}},
    {"name": "uos-x86_64-release", "configurePreset": "uos-x86_64-release", "output": {"outputOnFailure": true}}
  ]
}
